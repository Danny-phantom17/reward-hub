# Copy to the ignored .env.local file for local development. Never put production
# credentials here or commit .env.local.
DATABASE_URL=postgres://rewardhub_test_user:change-me@127.0.0.1:5432/rewardhub_test
TEST_DATABASE_URL=postgres://rewardhub_test_user:change-me@127.0.0.1:5432/rewardhub_test
PGSSL=false
PG_POOL_MAX=10

# Existing RewardHub settings
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
BANK_DETAILS_ENCRYPTION_KEY=replace-with-a-long-random-secret
ADVERTISER_FUNDING_INSTRUCTIONS=replace-with-verified-business-payment-instructions
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM=RewardHub <no-reply@your-verified-domain.example>
APP_BASE_URL=http://localhost:3000
